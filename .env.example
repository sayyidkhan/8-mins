# Server-only AI credentials. Set in .env or your deployment environment.
# Never use a VITE_ prefix or expose this key in client code.
# Local development: openai. Google AI Studio: gemini (also the default when unset).
DRAWING_AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# Production server port (npm run build && npm start).
PORT=3000

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
